# ============================================================
#  .gitignore para mexico_2008
#  Solo se versionan: codigo fuente (.f90 .F90), scripts de
#  configuracion/ejecucion (.sh.in, .am, .ac) y README.
#  Los datos de entrada/salida (CSV, TXT, NC, XLS*) NO.
# ============================================================

# --- Sistema / macOS ---
.DS_Store
*~

# --- Compilacion ---
*.[oa]
*.mod
*.MOD
*.exe
*.out
a.out

# --- Logs ---
*.log

# ============================================================
#  DATOS DE ENTRADA Y SALIDA (no versionar — demasiado grandes)
# ============================================================

# Todos los CSV de datos (entrada y salida de los programas)
*.csv
*.CSV

# Todos los TXT de salida de especiacion
*.txt
# EXCEPCIONES: mantener archivos de texto que son configuracion
!**/namelist*.nml

# NetCDF (salidas de 10_storage y 11_annual)
*.nc
*.NC

# Hojas de calculo (datos de referencia grandes)
*.xls
*.xlsx
*.XLS
*.XLSX

# PostScript / graficas
*.ps

# ZIP de datos
*.zip

# Archivos de salida numerados (salida.1, salida.2 ...)
salida*

# Archivos temporales especificos
.tmpfile
libnetcdf*

# 03_movilspatial — resultados intermedios
03_movilspatial/salida*.csv

# 04_temis — enlace simbolico de anio (generado en tiempo de ejecucion)
04_temis/anio2008.csv

# 10_storage — salidas WRF-Chem
10_storage/wrfc*

# ============================================================
#  ARCHIVOS GENERADOS POR AUTOTOOLS (no versionar)
# ============================================================
Makefile
Makefile.in
*/Makefile
*/Makefile.in
aclocal.m4
autom4te.cache/
build-aux/
config.status
config.log
configure
configure~
# Generado por configure a partir de ejecuta.sh.in
ejecuta.sh
